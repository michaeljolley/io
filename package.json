{
	"name": "io",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": ["packages/shared", "packages/daemon", "packages/tui", "packages/telegram"],
	"scripts": {
		"build": "npm run build --workspaces",
		"dev": "npm run dev --workspace=packages/daemon",
		"dev:tui": "npm run dev --workspace=packages/tui",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"typescript": "^5.7.0",
		"vitest": "^3.1.0"
	}
}
